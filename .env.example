# ============================================================
# COMSATS VSPARK — Quiz Competition
# Environment Configuration Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase (Public — safe to expose to browser) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Service Role (SERVER ONLY — NEVER expose to client) ──
# Used exclusively by server-side API routes that require bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application Base URL ────────────────────────────────────
# In production set this to your deployed domain (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Question-Bank Encryption (SERVER ONLY) ──────────────────
# AES-256-GCM key material for encrypted question-bank uploads.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER expose this to the browser or commit it. Rotating it makes existing
# banks undecryptable unless you also increment key_version and re-upload.
QUESTION_BANK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# ── Developer Credits — LinkedIn URLs ──────────────────────
# These power the footer Developer Credits section.
# Replace with the actual profile URLs before going live.
# If left unconfigured the footer shows a placeholder message.
NEXT_PUBLIC_DEVELOPER_ESHA_LINKEDIN_URL=https://www.linkedin.com/in/esha-minahil
NEXT_PUBLIC_DEVELOPER_SEERAT_LINKEDIN_URL=https://www.linkedin.com/in/seerat-rauf

# ── Legacy alias (kept for backward compatibility) ─────────
NEXT_PUBLIC_DEVELOPER_LINKEDIN_URL=https://www.linkedin.com/in/esha-minahil

# ── Optional: Email / Notification Service ─────────────────
# Uncomment and configure to enable transactional email notifications
# (registration approval, rejection, etc.) via Resend or SendGrid.
# If not set, only in-app notifications are delivered.
# EMAIL_API_KEY=
# EMAIL_FROM="COMSATS VSPARK <no-reply@cuivehari.edu.pk>"
